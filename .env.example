# Application Configuration
PROJECT_NAME="Hackathon Strategy Framework"
ENVIRONMENT="development"
DEBUG=true
PORT=8000

# Security & Authentication
SECRET_KEY="super-secret-hackathon-jwt-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret
POSTGRES_DB=hackathon_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secret@localhost:5432/hackathon_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# FastMCP Server
MCP_SERVER_URL=http://localhost:8001/sse
MCP_TRANSPORT=sse

# AI / LLM Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=hackathon-prototype
