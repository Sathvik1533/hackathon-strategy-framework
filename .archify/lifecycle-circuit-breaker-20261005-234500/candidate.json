    {
      "dot": "emerald",
      "title": "Closed State (Normal Pass-Through)",
      "items": [
        "All requests forward to external LLMs and microservices normally",
        "Failure counter tracks consecutive errors within 60s sliding window",
        "Sub-10ms Redis semantic cache intercepts repeat queries"
      ]
    },
    {
      "dot": "rose",
      "title": "Open State (Instant Fail-Fast Protection)",
      "items": [
        "Trips automatically after 5 consecutive upstream timeouts or 5xx codes",
        "Returns immediate fallback response without calling external endpoints",
        "Protects team stage demo from 14-second frozen browser requests"
      ]
    },
    {
      "dot": "amber",
      "title": "Half-Open State (Canary Probe)",
      "items": [
        "Activates automatically after 30-second recovery backoff window",
        "Allows exactly one trial probe to test upstream recovery",
        "Instantly resets to CLOSED on success, or re-trips for 30s on failure"
      ]
    }
